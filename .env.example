# LLM providers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
AGENT_LLM_ORDER=groq,gemini,openrouter,local

# Speech
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
AGENT_STT_ORDER=assemblyai,deepgram
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
AGENT_MICROPHONE_DEVICE=default

# Relay/offline
AGENT_RELAY_BASE_URL=
AGENT_RELAY_TOKEN=
AGENT_DIRECT_ALLOWED=true

# LiveKit Agents (optional production runtime)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=ai-aharon
LIVEKIT_STT_MODEL=deepgram/nova-3-general
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it
LIVEKIT_TTS_MODEL=inworld/inworld-tts-2
LIVEKIT_TTS_VOICE=Ashley

# Runtime
AGENT_DATA_DIR=data
AGENT_LOG_LEVEL=INFO
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_ATTEMPTS=2
AGENT_LLM_RETRY_BASE_SECONDS=0.25
AGENT_LLM_RETRY_MAX_SECONDS=2
AGENT_LLM_TRANSIENT_COOLDOWN_SECONDS=15
AGENT_LLM_RATE_LIMIT_COOLDOWN_SECONDS=60
AGENT_LLM_AUTH_COOLDOWN_SECONDS=300
