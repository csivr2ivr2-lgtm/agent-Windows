# Copy to .env. Never commit real secrets.
AGENT_LOG_LEVEL=INFO
AGENT_DATA_DIR=data
AGENT_MEMORY_BACKEND=sqlite
AGENT_LLM_ORDER=groq,gemini,openrouter,local
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_ATTEMPTS=2
AGENT_LLM_RETRY_BASE_SECONDS=0.25
AGENT_LLM_RETRY_MAX_SECONDS=2
AGENT_LLM_TRANSIENT_COOLDOWN_SECONDS=15
AGENT_LLM_RATE_LIMIT_COOLDOWN_SECONDS=60
AGENT_LLM_AUTH_COOLDOWN_SECONDS=300

GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=

ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
AGENT_STT_ORDER=assemblyai,deepgram
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_REALTIME_BACKEND=auto
LIVEKIT_AGENT_NAME=ai-aharon

QDRANT_URL=
QDRANT_API_KEY=
PINECONE_API_KEY=

# Low-bandwidth audio. Values are hypotheses until benchmarked on the target network/language.
AGENT_AUDIO_DIRECT_OR_RELAY=relay
AGENT_RELAY_BASE_URL=
AGENT_RELAY_TOKEN=
AGENT_DIRECT_ALLOWED=true
AGENT_MICROPHONE_DEVICE=default
AGENT_AUDIO_CODEC_ORDER=ogg_opus,mp3,pcm_s16le
AGENT_AUDIO_SAMPLE_RATE=16000
AGENT_AUDIO_CHANNELS=1
AGENT_AUDIO_MAX_CHUNK_BYTES=262144
AGENT_AUDIO_MAX_UPLOAD_BYTES=52428800
AGENT_AUDIO_OFFLINE_SPOOL_DIR=data/audio-spool

# Web intelligence: Wigolo local-first, Firecrawl cloud fallback/advanced.
WIGOLO_BASE_URL=http://127.0.0.1:3333
WIGOLO_TOKEN=
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Windows computer use: UFO primary, Windows-Use fallback.
AGENT_COMPUTER_BACKEND=auto
UFO_WORKDIR=
WINDOWS_USE_MODEL=

# Semantic memory tier. SQLite remains the durable local source of truth.
OPENVIKING_URL=
OPENVIKING_API_KEY=
OPENVIKING_SESSION_ID=ai-aharon
