RELAY_AGENT_TOKEN=replace-with-a-long-random-token
RELAY_STORAGE_DIR=/absolute/path/outside/webroot/agent-windows-relay
# Optional when the relay is mounted below a path such as /ai.
RELAY_BASE_PATH=
RELAY_MAX_CHUNK_BYTES=262144
RELAY_MAX_SESSION_BYTES=52428800
RELAY_RATE_LIMIT_PER_MINUTE=120
RELAY_REQUIRE_HTTPS=true
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-Proto.
RELAY_TRUST_PROXY=false
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
# Optional server-side ElevenLabs TTS streaming. Keep these only outside the web root.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3
